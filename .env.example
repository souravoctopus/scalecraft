# Copy to .env.local and fill in as needed. All values are optional.

# Public site URL — used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://skdscalecraftmedia.com

# Contact form endpoint (e.g. Formspree: https://formspree.io/f/xxxxxxx).
# Leave empty to open the visitor's email app with the enquiry pre-filled.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional custom Google Maps embed URL (Google Maps > Share > Embed a map > src).
# Leave empty to use the keyless address search embed.
NEXT_PUBLIC_MAP_EMBED_URL=

# Social profile URLs. Empty values show a muted "coming soon" icon.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
